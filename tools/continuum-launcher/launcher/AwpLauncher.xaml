<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="S.T.A.L.K.E.R.: Continuum" Width="1280" Height="810" MinWidth="920" MinHeight="640"
 WindowStartupLocation="CenterScreen" Background="#151515" Foreground="#E7E3DA" FontFamily="Segoe UI" WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResizeWithGrip">
 <Window.Resources>
  <SolidColorBrush x:Key="Gold" Color="#FFEA85"/>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{StaticResource Gold}"/><Setter Property="Background" Value="#221F17"/>
   <Setter Property="BorderBrush" Value="{StaticResource Gold}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="16,9"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
     <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#3D3520"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Height" Value="63"/>
   <Setter Property="Padding" Value="30,0"/><Setter Property="Foreground" Value="#ABABA6"/>
  </Style>
  <Style x:Key="TitleControl" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/>
   <Setter Property="Width" Value="37"/>
  </Style>
 </Window.Resources>
 <Border BorderThickness="1" BorderBrush="#30302E">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="43"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid x:Name="TitleBar" Background="#161616">
    <TextBlock Text="S.T.A.L.K.E.R.: Continuum Launcher" VerticalAlignment="Center" Margin="22,0,0,0" FontSize="11" Foreground="#AAA9A4"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,5,0">
     <Button x:Name="Minimize" Style="{StaticResource TitleControl}" Content="—"/>
     <Button x:Name="Maximize" Style="{StaticResource TitleControl}" Content="□"/>
     <Button x:Name="Close" Style="{StaticResource TitleControl}" Content="×" FontSize="20"/>
    </StackPanel>
   </Grid>
   <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="282"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border BorderBrush="#252524" BorderThickness="0,0,1,0">
     <Grid>
      <Image x:Name="SidebarArt" Stretch="UniformToFill" Opacity=".12"/>
      <Grid Margin="0,47,0,26">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel>
        <Button x:Name="HomeTab" Style="{StaticResource Nav}" Content="⌂      Home"/>
        <Button x:Name="SavesTab" Style="{StaticResource Nav}" Content="▤      Saves"/>
        <Button x:Name="AddonsTab" Style="{StaticResource Nav}" Content="✚      Add-ons"/>
       </StackPanel>
       <StackPanel Grid.Row="2">
        <Button x:Name="SettingsTab" Style="{StaticResource Nav}" Content="⚙      Settings"/>
       </StackPanel>
      </Grid>
     </Grid>
    </Border>
    <Grid Grid.Column="1">
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="130"/></Grid.RowDefinitions>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="43,42,42,18">
       <StackPanel x:Name="HomePage">
        <Grid Height="428">
         <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="29"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
         <Border CornerRadius="4" Background="#25231E" ClipToBounds="True">
          <Grid>
           <Image x:Name="HeroArt" Stretch="UniformToFill" Opacity=".67"/>
           <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#22000000"/><GradientStop Offset=".55" Color="#76000000"/><GradientStop Offset="1" Color="#D9000000"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
           <Grid Margin="34">
            <TextBlock Text="ADVANCED WEAPON PACK" FontSize="27" FontWeight="Bold" Foreground="{StaticResource Gold}" VerticalAlignment="Top" Margin="0,8,0,0"/>
           </Grid>
          </Grid>
         </Border>
         <Border Grid.Column="2" CornerRadius="4" Background="#27251E" ClipToBounds="True">
          <Grid>
           <Image x:Name="SponsorArt" Stretch="UniformToFill" Opacity=".4"/>
           <StackPanel Margin="34,32">
            <TextBlock Text="S.T.A.L.K.E.R." FontSize="21" Foreground="#D1CFC4"/>
            <TextBlock Text="TRILOGY" FontSize="25" FontWeight="Bold" Foreground="{StaticResource Gold}" Margin="0,14,0,0"/>
            <TextBlock Text="MULTIPLAYER CAMPAIGN" FontSize="18" Foreground="#D1CFC4"/>
            <TextBlock Text="PROFILE" FontSize="18" Margin="0,42,0,8" Foreground="#D1CFC4"/>
            <TextBlock x:Name="HomeSave" TextWrapping="Wrap" Foreground="#E0DED5" FontSize="14"/>
           </StackPanel>
          </Grid>
         </Border>
        </Grid>
        <UniformGrid Columns="3" Margin="0,31,0,0" Height="112">
         <Button x:Name="SavesCard" Margin="0,0,13,0" Padding="0" BorderThickness="0" HorizontalContentAlignment="Stretch"><Grid><Image x:Name="Tile1" Stretch="UniformToFill" Opacity=".64"/><TextBlock Text="SAVES" Margin="12" VerticalAlignment="Bottom" Foreground="White"/></Grid></Button>
         <Button x:Name="AddonsCard" Margin="7,0" Padding="0" BorderThickness="0" HorizontalContentAlignment="Stretch"><Grid><Image x:Name="Tile2" Stretch="UniformToFill" Opacity=".64"/><TextBlock Text="ADD-ONS" Margin="12" VerticalAlignment="Bottom" Foreground="White"/></Grid></Button>
         <Button x:Name="SettingsCard" Margin="13,0,0,0" Padding="0" BorderThickness="0" HorizontalContentAlignment="Stretch"><Grid><Image x:Name="Tile3" Stretch="UniformToFill" Opacity=".64"/><TextBlock Text="SETTINGS" Margin="12" VerticalAlignment="Bottom" Foreground="White"/></Grid></Button>
        </UniformGrid>
       </StackPanel>
       <StackPanel x:Name="SavesPage" Visibility="Collapsed">
        <TextBlock Text="Saves" FontSize="30" Foreground="{StaticResource Gold}"/>
        <Border Background="#20201F" Padding="25" Margin="0,22,0,0"><StackPanel>
         <TextBlock x:Name="LatestSave" Margin="0,13,0,7" TextWrapping="Wrap"/>
         <ListBox x:Name="SaveList" MaxHeight="275" Padding="4" Background="#232321" Foreground="#E3E1D8"
                  BorderBrush="#3C3A32" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  AutomationProperties.Name="Saved games">
          <ListBox.ItemContainerStyle>
           <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
           </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
           <DataTemplate>
            <Grid>
             <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
             <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold"/>
             <TextBlock Grid.Column="1" Text="{Binding DisplayDate}" Margin="16,0,0,0"/>
            </Grid>
           </DataTemplate>
          </ListBox.ItemTemplate>
         </ListBox>
         <WrapPanel Margin="0,18,0,0">
          <Button x:Name="DeleteSave" Content="Delete save" Margin="0,0,12,0" IsEnabled="False"/>
          <Button x:Name="Refresh" Content="Refresh saves" Margin="0,0,12,0"/>
          <Button x:Name="OpenSaves" Content="Open save folder"/>
         </WrapPanel>
         <Expander x:Name="RemovedSavesPanel" Header="Removed saves" Margin="0,20,0,0" Visibility="Collapsed" Foreground="#E3E1D8">
          <StackPanel>
           <ListBox x:Name="RemovedSaveList" MaxHeight="150" Margin="0,10,0,10" Padding="4" DisplayMemberPath="DisplayName"
                    Background="#232321" Foreground="#E3E1D8" BorderBrush="#3C3A32" AutomationProperties.Name="Removed saves"/>
           <Button x:Name="RestoreSave" Content="Restore selected save" IsEnabled="False" HorizontalAlignment="Left"/>
          </StackPanel>
         </Expander>
        </StackPanel></Border>
       </StackPanel>
       <StackPanel x:Name="AddonsPage" Visibility="Collapsed">
        <TextBlock Text="Add-ons" FontSize="30" Foreground="{StaticResource Gold}"/>
        <TextBlock x:Name="AddonSummary" Foreground="#B8B6AD" TextWrapping="Wrap" Margin="0,12,0,16"
                   AutomationProperties.LiveSetting="Polite"/>
        <ListBox x:Name="AddonList" Visibility="Collapsed" MaxHeight="330" Padding="4" Background="#20201F"
                 Foreground="#E3E1D8" BorderBrush="#3C3A32" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="Installed add-ons">
         <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
           <Setter Property="Padding" Value="12,9"/>
           <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
           <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
          </Style>
         </ListBox.ItemContainerStyle>
         <ListBox.ItemTemplate>
          <DataTemplate>
           <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1" Text="{Binding Version}" Margin="16,0,0,0"/>
           </Grid>
          </DataTemplate>
         </ListBox.ItemTemplate>
        </ListBox>
        <WrapPanel Margin="0,16,0,0">
         <Button x:Name="RefreshAddons" Content="Refresh add-ons" Margin="0,0,12,0"/>
         <Button x:Name="OpenAddons" Content="Open gamedata folder"/>
        </WrapPanel>
       </StackPanel>
       <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
        <TextBlock Text="Settings" FontSize="30" Foreground="{StaticResource Gold}"/>
        <Border Background="#20201F" Padding="25" Margin="0,22,0,0"><StackPanel>
         <StackPanel.Resources>
          <Style TargetType="Label">
           <Setter Property="Foreground" Value="#E3E1D8"/>
           <Setter Property="Padding" Value="0,0,0,5"/>
          </Style>
          <Style TargetType="TextBox">
           <Setter Property="Foreground" Value="#E3E1D8"/>
           <Setter Property="Background" Value="#262623"/>
           <Setter Property="BorderBrush" Value="#514E43"/>
           <Setter Property="Padding" Value="8,5"/>
          </Style>
         </StackPanel.Resources>
         <WrapPanel>
          <Button x:Name="SettingsApply" Content="Save settings" Margin="0,0,12,0" IsEnabled="False"/>
          <Button x:Name="SettingsReload" Content="Discard and reload"/>
         </WrapPanel>
         <TextBlock x:Name="SettingsNotice" Margin="0,10,0,14" TextWrapping="Wrap" Foreground="#B8B6AD"
                    AutomationProperties.LiveSetting="Polite"/>
         <TabControl x:Name="SettingsSections" Background="#20201F" BorderBrush="#514E43" IsEnabled="False"
                     AutomationProperties.Name="Game settings categories"/>
        </StackPanel></Border>
        <Border Background="#20201F" Padding="25" Margin="0,18,0,0"><StackPanel>
         <TextBlock Text="GAME INSTALLATION" FontSize="19" FontWeight="SemiBold"/>
         <TextBlock x:Name="GamePath" TextWrapping="Wrap" Margin="0,12,0,18"/>
         <Button x:Name="OpenGame" Content="Open game folder" HorizontalAlignment="Left"/>
        </StackPanel></Border>
       </StackPanel>
      </Grid>
     </ScrollViewer>
     <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="#20201F" Background="#171717">
      <Grid Margin="43,0,42,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
       <TextBlock x:Name="Status" VerticalAlignment="Center" Margin="0,0,22,0" TextWrapping="Wrap" Foreground="#B8B6AD"/>
       <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <Button x:Name="Update" Content="UPDATE" Margin="0,0,0,8" Height="36"/>
        <Button x:Name="Play" Content="PLAY" FontSize="16" Background="Transparent" BorderThickness="2" Height="44"/>
       </StackPanel>
      </Grid>
     </Border>
    </Grid>
   </Grid>
  </Grid>
 </Border>
</Window>
